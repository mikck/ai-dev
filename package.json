{
  "name": "ai-dev",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run build && CGO_ENABLED=1 CGO_CFLAGS=\"-O1 -g0\" AIDEV_TEST_BINARY=\"$PWD/bin/ai-dev\" go test -trimpath -tags netgo,osusergo,sqlite_omit_load_extension -count=1 ./...",
    "build": "npm run build:ui && mkdir -p bin && CGO_ENABLED=1 CGO_CFLAGS=\"-O1 -g0\" go build -trimpath -tags netgo,osusergo,sqlite_omit_load_extension -ldflags \"-linkmode external -extldflags -static\" -o bin/ai-dev .",
    "start": "./bin/ai-dev serve",
    "executor": "./bin/ai-dev executor",
    "build:ui": "esbuild frontend/Console.jsx --bundle --jsx=automatic --minify --loader:.woff2=dataurl --outfile=public/app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikck/ai-dev.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mikck/ai-dev/issues"
  },
  "homepage": "https://github.com/mikck/ai-dev#readme",
  "dependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@stylexjs/stylex": "^0.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true
}
